# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the site (used for canonical URLs, sitemap, Open Graph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example.tn

# Supabase (server-side only — the service-role key bypasses RLS)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Preview mode: serve the read-only catalogue from data/products.json instead of Supabase.
USE_SEED_DATA=false

# Admin — password must be ≥ 12 chars in production, secret ≥ 32 chars.
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_PASSWORD=
ADMIN_SECRET=

# Optional: prescription reader (photo → values). Without a key the page offers manual entry only.
# The key stays on the server; it is never sent to the browser.
ANTHROPIC_API_KEY=
# Cost guard: maximum prescription readings per day across all visitors.
PRESCRIPTION_DAILY_LIMIT=300

# Optional: social profile URLs (icons are hidden when empty)
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=

# Optional: Google Analytics 4 (sets cookies — add a consent banner before enabling)
NEXT_PUBLIC_GA_ID=
